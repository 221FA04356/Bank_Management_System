# Copy this file to .env for local development.
# Keep .env private. Set these same names in your deployment platform dashboard.

DB_URL=jdbc:mysql://localhost:3306/bankSystem?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASS=

# Leave MAIL_HOST empty to print OTP emails in the console.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=JavaBank

ADMIN_CARD=1000000000000000
ADMIN_PIN=change-this-before-deploying

OTP_THRESHOLD=10000
COOKIE_SECURE=false
THYMELEAF_CACHE=false
